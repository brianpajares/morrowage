# MorrowAge v4 · copiar a .env.local y reemplazar con secretos reales.
# Nunca versionar valores reales.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_VERSION=4.0.0
MODEL_VERSION=2.1
MONETIZATION_MODE=validation
STRIPE_ENABLED=false
REPORT_TOKEN_TTL_HOURS=168
REPORT_RETENTION_DAYS=30

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Google Drive
GOOGLE_SERVICE_ACCOUNT_EMAIL=service-account@YOUR_PROJECT.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID=YOUR_MORROWAGE_FOLDER_ID
GOOGLE_DRIVE_APP_ROOT=/Apps/morrowage
DRIVE_CACHE_TTL_SECONDS=86400

# Email / Resend
RESEND_API_KEY=re_REPLACE_ME
EMAIL_FROM=MorrowAge <reports@YOUR_DOMAIN>
OWNER_EMAIL=owner@YOUR_DOMAIN

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=phc_REPLACE_ME
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
SENTRY_DSN=https://REPLACE_ME@sentry.io/PROJECT_ID
NEXT_PUBLIC_SENTRY_DSN=https://REPLACE_ME@sentry.io/PROJECT_ID

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=REPLACE_ME
TURNSTILE_SECRET_KEY=REPLACE_ME

# Rate limit reference implementation (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://REPLACE_ME.upstash.io
UPSTASH_REDIS_REST_TOKEN=REPLACE_ME

# Stripe · keep disabled in validation
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_PRICE_REPORT_USD=price_REPLACE_ME

# Añadidas por la implementación (DECISIONS.md, 2026-10-07)
# Secreto para el cron de Vercel y para ver capacidades en /api/health (openssl rand -hex 32)
CRON_SECRET=REPLACE_ME
# Pepper para hashes de sesión/rate limit. Opcional: si falta se deriva de SUPABASE_SERVICE_ROLE_KEY.
SESSION_PEPPER=REPLACE_ME
# Contacto de privacidad mostrado en /privacy (opcional; no usar el buzón OWNER_EMAIL)
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
