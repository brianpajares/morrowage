{
  "name": "morrowage",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "description": "MorrowAge — edad equivalente de riesgo poblacional (modelo v2.1).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:vectors": "vitest run src/lib/model/vectors.test.ts",
    "test:e2e": "playwright test",
    "test:rls": "vitest run supabase/tests",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:placeholders": "tsx scripts/check-placeholders.ts",
    "check:drive": "tsx scripts/check-drive-manifest.ts",
    "drive:sync": "tsx scripts/drive-sync.ts",
    "db:bundle": "tsx scripts/build-sql-bundle.ts",
    "perf:api": "tsx scripts/perf-api.ts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@sentry/nextjs": "^11.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "@upstash/ratelimit": "^2.2.0",
    "@upstash/redis": "^1.39.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "jose": "^6.2.12",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-intl": "^4.14.9",
    "posthog-js": "^1.438.2",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^9.39.0",
    "eslint-config-next": "16.4.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "unpdf": "^1.8.1",
    "vitest": "^5.0.3"
  }
}
