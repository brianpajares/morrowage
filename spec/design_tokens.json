  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999
  },
  "shadow": {
    "sm": "0 1px 2px rgba(15,23,42,.08)",
    "md": "0 8px 24px rgba(15,23,42,.10)",
    "lg": "0 20px 50px rgba(15,23,42,.14)"
  },
  "motion": {
    "fast_ms": 120,
    "normal_ms": 200,
    "slow_ms": 320,
    "reduced_motion": "disable nonessential transforms/animations"
  },
  "layout": {
    "content_max": 1120,
    "reading_max": 720,
    "breakpoints": {
      "mobile": 360,
      "tablet": 768,
      "desktop": 1280
    },
    "touch_target_min": 44
  },
  "chart": {
    "rules": [
      "Never use color alone; combine label/icon/pattern.",
      "MorrowAge hero uses chronological vs equivalent age only when equivalent age is within 40–69.",
      "Out-of-range output uses boundary marker and explanatory text, not an off-scale bar.",
      "Driver charts are diverging bars around zero and labelled 'association', never 'cause'.",
      "Sensitivity uses low/base/high dots or interval line labelled 'measurement scenario', never confidence interval."
    ]
  }
}
